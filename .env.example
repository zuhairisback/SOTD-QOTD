# Copy this file to .env and fill in your own values. Never commit .env.

DISCORD_TOKEN=your-bot-token-here

# Optional but recommended while testing: your server's ID.
# Makes slash commands show up instantly instead of taking up to an hour.
GUILD_ID=

# Right-click each channel in Discord (Developer Mode must be on) -> Copy Channel ID
QOTD_CHANNEL_ID=123456789012345678
SOTD_CHANNEL_ID=123456789012345678

# REQUIRED for daily draws to work: a private channel (only admins/mods can see it)
# where each day's random pick is sent for review before it's published.
REVIEW_CHANNEL_ID=123456789012345678

# Optional: a channel to post "running low on submissions" nudges to.
# Leave blank (0) to disable.
NUDGE_CHANNEL_ID=0
# Nudge fires when a pool's remaining count drops to/below this number.
NUDGE_THRESHOLD=3

# Optional: roles pinged in the message when a Song/Question of the Day is actually
# PUBLISHED (not on the private draw). Right-click a role -> Copy Role ID. Leave
# blank (0) to skip pinging.
SOTD_ROLE_ID=0
QOTD_ROLE_ID=0

# IANA timezone name, e.g. Europe/London, America/New_York, Australia/Sydney
TIMEZONE=Europe/London

# 24-hour clock, in the timezone above — this is when the bot DRAWS a pick for
# review each day, not necessarily when it goes public (that's on /approve).
POST_HOUR=17
POST_MINUTE=0

# Where the SQLite database file is stored
DB_PATH=data.db
